  async function fetchInstagramProfile(username) {
    const WORKER = 'https://igick.com/api/public/lookup';
    for (let i = 0; i < 4; i++) {
      try {
        const controller = new AbortController();
        const timer = setTimeout(() => controller.abort(), 12000);
        const res = await fetch(WORKER + '?u=' + encodeURIComponent(username), { signal: controller.signal });
        clearTimeout(timer);
        if (!res.ok) { await new Promise(r => setTimeout(r, 600)); continue; }
        const data = await res.json();
        const user = data?.data?.user;
        if (!user) { await new Promise(r => setTimeout(r, 600)); continue; }
        const pic = user.profile_pic_url_hd || user.profile_pic_url;
        const followers = user.edge_followed_by?.count ?? 0;
        if (!pic && followers === 0) { await new Promise(r => setTimeout(r, 600)); continue; }
        return { pic, followers: user.edge_followed_by?.count, following: user.edge_follow?.count, fullName: user.full_name, bio: user.biography, isPrivate: user.is_private, posts: user.edge_owner_to_timeline_media?.count };
      } catch(e) { await new Promise(r => setTimeout(r, 600)); }
    }
    return null;
  }
  const connectStatuses = ["Establishing encrypted tunnel…","Bypassing privacy filters…","Accessing profile data…","Cross-referencing database…","Compiling intelligence…","Finalizing report…"];
