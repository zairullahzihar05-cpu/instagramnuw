  }

  const ROUTES = {viewers:'ig-result-viewers.html',following:'ig-result-following.html',private:'ig-result-private.html',search:'ig-result-search.html',dms:'ig-result-dms.html',activity:'ig-result-activity.html'};
  const TNAMES = {viewers:'WHO VIEWED MY PROFILE',following:'WHO THEY FOLLOW',private:'VIEW PRIVATE ACCOUNT',search:'REVEAL SEARCH HISTORY',dms:'CHECK DM MESSAGES',activity:'REAL-TIME ACTIVITY'};
  const MALE_W=['jake','tyler','ryan','kyle','brandon','justin','chris','michael','jason','derek','logan','mason','hunter','zach','matt','nick','drew','cole','liam','noah','ethan','james','luke','owen','jack','adam','dylan','sean','kevin','marcus','cam','king'];
  const FEMALE_W=['madison','olivia','sophia','emma','ava','isabella','mia','charlotte','amelia','harper','lily','zoey','chloe','riley','layla','nora','addison','stella','brooklyn','ashley','jessica','sarah','emily','hannah','grace','luna','bella'];
  function detectGender(u){const s=u.toLowerCase().replace(/[^a-z]/g,'');for(const w of FEMALE_W)if(s.includes(w))return'female';for(const w of MALE_W)if(s.includes(w))return'male';return Math.random()>.4?'male':'female';}

