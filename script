    const interval = setInterval(() => {
      pct = Math.min(pct + Math.random() * 5 + 3, 95);
      fill.style.width = pct + '%'; pctEl.textContent = Math.floor(pct) + '%';
      if (step < connectStatuses.length) statusEl.textContent = connectStatuses[step++];
      
      // Add terminal lines based on progress
      if (terminalEl && termIdx < terminalMessages.length && pct > (termIdx * 10 + 10)) {
        const line = document.createElement('div');
        line.className = 'terminal-line';
        line.textContent = terminalMessages[termIdx++];
        terminalEl.appendChild(line);
        terminalEl.scrollTop = terminalEl.scrollHeight;
      }
      
      if (pct >= 95 && fetchDone) {
        clearInterval(interval); fill.style.width = '100%'; pctEl.textContent = '100%'; statusEl.textContent = 'Access granted.';
        setTimeout(() => { barDone = true; tryShow(); }, 300);
      }
    }, 300);
  }

