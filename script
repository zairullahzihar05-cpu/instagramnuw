    if (toolKey==='following') {
      let h='';
      for(let i=0;i<5;i++){const eng=rI(52,98);h+=row('#f5c842',bAv(36,'#f5c842'),bLine(rI(80,130))+`<div style="height:3px;width:${rI(60,100)}%;background:linear-gradient(90deg,#f58529,#f5c842);opacity:.3;border-radius:99px;margin-top:4px"></div>`,`<div style="font-family:JetBrains Mono,monospace;font-size:.5rem;color:rgba(245,200,66,.5)">${eng}%</div>`);}
      return h;
    }
    if (toolKey==='private') {
      const pc=igProfileData&&igProfileData.posts?igProfileData.posts:rI(6,24);
      const cc=Math.min(pc,9), gs=gender==='male'?'women':'men';
      let h=`<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:2px;border-radius:6px;overflow:hidden">`;
      for(let i=0;i<cc;i++){const pid=(i%15)+1;
        h+=`<div style="aspect-ratio:1;position:relative;overflow:hidden;background:#0a0a0a"><img src="https://randomuser.me/api/portraits/${gs}/${pid}.jpg" style="width:100%;height:100%;object-fit:cover;filter:blur(18px) brightness(0.5)" /><div style="position:absolute;inset:0;background:rgba(0,0,0,.55);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px"><span style="font-size:.85rem">🔒</span><span style="font-family:JetBrains Mono,monospace;font-size:.36rem;letter-spacing:.1em;color:rgba(255,255,255,.4);text-transform:uppercase">PRIVATE</span></div></div>`;}
      return h+'</div>';
    }
    if (toolKey==='search') {
      const maxS=rI(80,130); let h='';
      for(let i=0;i<4;i++){const s=i===0?maxS:rI(5,maxS-5),pct=Math.round(s/maxS*100);
        h+=row('#00ff88',bAv(36,'#00ff88'),bLine(rI(80,130))+`<div style="height:2px;width:${pct}%;background:linear-gradient(90deg,#f58529,#dd2a7b);opacity:.4;border-radius:99px;margin-top:5px"></div>`,`<div style="font-family:Bebas Neue,sans-serif;font-size:.9rem;color:rgba(0,255,136,.5)">${s}X</div>`);}
      for(let i=0;i<2;i++) h+=`<div style="display:flex;align-items:center;gap:8px;padding:5px 0"><span style="font-size:.75rem">🔍</span>${bLine(rI(70,120),8,.12)}</div>`;
      return h;
    }
    if (toolKey==='dms') {
      const unreads=[3,7,0,2,5,1];
      let h=`<div style="font-family:JetBrains Mono,monospace;font-size:.5rem;letter-spacing:.18em;color:rgba(255,255,255,.15);text-align:center;margin-bottom:6px">— INBOX —</div>`;
      for(let i=0;i<6;i++){const u=unreads[i];
        h+=row('#2AABEE',bAv(36,'#2AABEE'),bLine(rI(70,120))+bLine(rI(80,140),7,.08),u>0?`<div style="width:17px;height:17px;border-radius:50%;background:rgba(221,42,123,.7);display:flex;align-items:center;justify-content:center;font-family:JetBrains Mono,monospace;font-size:.5rem;color:#fff">${u}</div>`:'');}
      return h;
    }
    if (toolKey==='activity') {
      const online=Math.random()>.35;
      let h=`<div style="background:rgba(0,255,136,.05);border:1px solid rgba(0,255,136,.15);border-radius:8px;padding:8px 10px;display:flex;align-items:center;gap:8px;margin-bottom:8px"><span style="font-size:1rem">${online?'🟢':'💤'}</span><div><div style="font-family:Bebas Neue,sans-serif;font-size:.85rem;color:${online?'#00ff88':'rgba(255,255,255,.4)'}">${online?'● CURRENTLY ONLINE':'LAST SEEN RECENTLY'}</div><div style="font-family:JetBrains Mono,monospace;font-size:.5rem;color:rgba(255,255,255,.25);margin-top:2px">${online?`Active · ${rI(1,45)}m ago`:`${rI(10,120)}m ago`}</div></div></div>`;
      const evs=['🟢','📸','🔍','❤️','💬'],dots=['rgba(0,255,136,.6)','rgba(221,42,123,.6)','rgba(245,133,41,.6)','rgba(221,42,123,.6)','rgba(81,91,212,.6)'];
      for(let i=0;i<5;i++) h+=`<div style="display:flex;gap:8px;margin-bottom:6px;align-items:center"><div style="width:7px;height:7px;border-radius:50%;background:${dots[i]};flex-shrink:0"></div><span style="font-size:.75rem">${evs[i]}</span>${bLine(rI(80,140),8,.15)}</div>`;
      return h;
    }
    let h='';
    for(let i=0;i<6;i++) h+=`<div style="height:10px;background:rgba(255,255,255,.06);border-radius:4px;margin-bottom:6px;filter:blur(3px)"></div>`;
    return h;
  }
  function closeCaptcha() { document.getElementById('captchaOverlay').classList.remove('visible'); }
  function resetForm() {
    document.getElementById('userFoundCard').classList.remove('visible');
    document.getElementById('cardsSection').classList.remove('visible');
    for (let i = 0; i < 6; i++) {
      const card = document.getElementById('card' + i);
      if (card) card.classList.remove('show');
    }
    document.getElementById('usernameInput').value = '';
    document.getElementById('progressFill').style.width = '0%';
    document.getElementById('targetSection').style.display = 'flex';
    currentUsername = '';
    igProfileData = null;
  }
  document.getElementById('usernameInput').addEventListener('keydown', e => { if (e.key === 'Enter') startConnect(); });

  // ════════════════════════════════════════════════
  //  ★ NEW SEO ACCORDION FUNCTION ★
  // ════════════════════════════════════════════════
  function toggleSeoAccordion(btn) {
    const content = document.getElementById('seoToolsContent');
    content.classList.toggle('open');
    btn.classList.toggle('open');
    btn.querySelector('.arrow').textContent = content.classList.contains('open') ? '▲' : '▼';
  }
</script>
